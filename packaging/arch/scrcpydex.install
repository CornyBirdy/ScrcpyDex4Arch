post_install() {
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --subsystem-match=usb 2>/dev/null || true
    echo ">> ScrcpyDeX: reconnect your phone (USB debugging enabled) so the new udev rule is applied."
    echo ">> Run 'scrcpydex-cli doctor' to verify the setup."
}

post_upgrade() {
    post_install
}

pre_remove() {
    pkill -f "/usr/lib/scrcpydex/" 2>/dev/null || true
}

post_remove() {
    udevadm control --reload-rules 2>/dev/null || true
}
